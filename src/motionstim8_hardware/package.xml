<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>motionstim8_hardware</name>
  <version>0.0.0</version>

  <description>ROS2 interface for the MotionStim8 functional electrical stimulation device.</description>
  
  <maintainer email="bruna@todo.todo">bruna</maintainer>

  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>pluginlib</depend>
  <depend>hardware_interface</depend>
  <depend>motionstim8_driver</depend>
  <depend>fes_bringup</depend>
  
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <pluginlib plugin="${prefix}/motionstim8_hardware_plugin.xml"/>
  </export>
</package>
